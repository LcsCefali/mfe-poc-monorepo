{
  "name": "mfe-poc-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "pnpm -r start",
    "start:host": "pnpm --filter host-app start",
    "start:rootzz": "pnpm --filter rootzz start",
    "start:catalog": "pnpm --filter catalog-app start",
    "start:checkout": "pnpm --filter checkout-app start",
    "run:host:android": "pnpm --filter host-app android",
    "run:host:ios": "pnpm --filter host-app ios",
    "prepare:repack": "sh -c '(cd apps/$0 && pnpm dlx @callstack/repack-init)'",
    "create:app": "sh -c 'npx @react-native-community/cli init $0 --directory apps/$1 --skip-install --skip-git-init'",
    "pod": "sh -c '(cd apps/$0/ios && pod install)'",
    "pods": "pnpm -r pods",
    "pods:update": "pnpm -r pods:update",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "align-deps": "pnpm -r align-deps",
    "check-deps": "pnpm -r check-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@callstack/repack": "^5.2.3",
    "@eduzz/eslint-config": "2.5.7-rc.0",
    "@rnx-kit/align-deps": "^3.4.0",
    "eslint": "^8.57.1",
    "terser-webpack-plugin": "^5.3.16",
    "webpack": "^5.104.1"
  }
}
